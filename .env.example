# ==========================================
# Smart Resume Analyzer - Environment Config
# ==========================================

# Server Port
PORT=8080

# Spring Profiles: dev (default H2), mysql
SPRING_PROFILES_ACTIVE=dev

# MySQL Configuration (only required if running with -Dspring-boot.run.profiles=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=smart_resume_db
MYSQL_USER=root
MYSQL_PASSWORD=root

# JWT Authentication
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# File Storage
UPLOAD_DIR=./uploads/resumes

# AI Integration (Optional: Fallback deterministic engine is automatically enabled when empty)
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
